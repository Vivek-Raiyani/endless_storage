# Project Settings
PROJECT_NAME="FastAPI Template"
SERVER_HOST="http://localhost:8000"
DATABASE_URL="sqlite+aiosqlite:///./test.db"
FRONTEND_URL="http://localhost:3000"
BACKEND_CORS_ORIGINS='["*"]'

# Auth Settings
SECRET_KEY="your-super-secret-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Email Settings
EMAIL_PROVIDER="smtp"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
RESEND_API_KEY=""

# Google OAuth Settings
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Drive Storage Settings
# Scope: "https://www.googleapis.com/auth/drive.file" (non-sensitive, app-created files only)
GOOGLE_DRIVE_SCOPE="https://www.googleapis.com/auth/drive.file"
# Fixed chunk size in bytes (default 256 MB = 268435456)
CHUNK_SIZE_BYTES=268435456
# Fernet key for encrypting refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=""


